<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete an Event</title>
</head>
<body>
    <% if (typeof(error) !== 'undefined' && error) { %>
        <p style="color: red; font-weight: bold;"><%= error %></p>
    <% } %>

    <h2>Delete Events</h2>

    <p><a href="/events">← Back to Events</a></p>

        <form action="/events/delete-event" method="post">
            <!-- Delete an event. Make it with checkbox so admin can delete multiple events easily -->
            <table border="1">
                <thead>
                    <tr>
                        <th>Events</th>
                        <th>Delete?</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                    <% events.forEach(event => { %>
                        <td>
                            <%= event.title %>
                        </td>

                        <td>
                            <input type="checkbox" name="deleteEventIds" value="<%= event._id %>">
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <br>
            <button type="submit">Confirm Delete Event</button>



        </form>
</body>
</html>