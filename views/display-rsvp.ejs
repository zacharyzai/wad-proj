<!DOCTYPE html>
<html>
<head>
    <title>My RSVPs</title>
</head>
<body>
    <h1>My RSVPs</h1>

    <% if (rsvpData.length === 0) { %>
        <p>You have not RSVP'd for any events yet.</p>
    <% } else { %>
        <ul>
            <% rsvpData.forEach(item => { %>
                <li>
                    <strong><%= item.event.title %></strong>
                    - <%= item.rsvp.status %>

                    <% if (item.rsvp.note) { %>
                        - <%= item.rsvp.note %>
                    <% } %>

                    <a href="/rsvp/view-rsvp?id=<%= item.rsvp._id %>">View</a>
                    <a href="/rsvp/update-rsvp?id=<%= item.rsvp._id %>">Update</a>
                    <a href="/rsvp/delete-rsvp?id=<%= item.rsvp._id %>">Delete</a>
                </li>
            <% }) %>
        </ul>
    <% } %>
</body>
</html>