<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete an Event</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <% if (typeof(error) !== 'undefined' && error) { %>
        <p style="color: red; font-weight: bold;"><%= error %></p>
    <% } %>

    <h2>Delete Events</h2>

    <p><a href="/events">← Back to Events</a></p>

        <% if (events.length === 0) { %>
            <p>No events to be deleted.</p>
        <% } else { %>
            <form action="/events/delete-event" method="post">
                <table border="1">
                    <thead>
                        <tr>
                            <th>Events</th>
                            <th>Delete?</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% events.forEach(event => { %>
                        <tr>
                            <td>
                                <%= event.title %>
                            </td>
                            <td>
                                <input type="checkbox" name="deleteEventIds" value="<%= event._id %>">
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <br>
                <button type="submit" onclick="return confirm('Are you sure you want to delete the selected events? This cannot be undone.')">Confirm Delete Event</button>
            </form>
        <% } %>
</body>
</html>