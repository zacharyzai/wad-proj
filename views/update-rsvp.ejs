<!DOCTYPE html>
<html>
<head>
    <title>Update RSVP</title>
</head>
<body>
    <h1>Update RSVP</h1>

    <p><strong>Event:</strong> <%= event.title %></p>

    <form action="/rsvp/update-rsvp" method="POST">
        <input type="hidden" name="rsvpId" value="<%= result._id %>">

        <label>Status:</label>
        <select name="status">
            <option value="Going" <%= result.status === "Going" ? "selected" : "" %>>Going</option>
            <option value="Maybe" <%= result.status === "Maybe" ? "selected" : "" %>>Maybe</option>
            <option value="Not Going" <%= result.status === "Not Going" ? "selected" : "" %>>Not Going</option>
        </select>

        <br><br>

        <label>Note:</label>
        <input type="text" name="note" value="<%= result.note %>">

        <br><br>

        <button type="submit">Update RSVP</button>
    </form>

    <br>
    <a href="/rsvp/view-rsvp?id=<%= result._id %>">Back</a>
</body>
</html>