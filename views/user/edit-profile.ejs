<!DOCTYPE html>
<html>
  <head>
    <title>Edit Profile</title>
  </head>
  <body align="center">
    <center>
        <br>
        <h1>👤 Edit Your Profile</h1>
        <p>Keep your information up to date so the campus community can reach you.</p>
        
        <%- include('../partials/navbar') %>

        <hr width="60%">

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <table border="1" cellpadding="10" bgcolor="#ffe6e6" width="45%">
                <tr>
                    <td>
                        <strong>⚠️ Update Issues:</strong>
                        <ul>
                            <% errors.forEach(error => { %>
                                <li><%= error %></li>
                            <% }); %>
                        </ul>
                    </td>
                </tr>
            </table>
            <br>
        <% } %>

        <form action="/profile/edit" method="post">
            <table border="1" cellpadding="10" width="50%">
                <tr bgcolor="#eeeeee">
                    <th colspan="2">Personal Information</th>
                </tr>
                <tr>
                    <td align="right"><strong>👤 Full Name:</strong></td>
                    <td align="left">
                        <input type="text" name="name" value="<%= user.name %>" required size="30">
                    </td>
                </tr>
                <tr>
                    <td align="right"><strong>📧 Email Address:</strong></td>
                    <td align="left">
                        <input type="email" name="email" value="<%= user.email %>" required size="30">
                    </td>
                </tr>
                <tr bgcolor="#f9f9f9">
                    <th colspan="2">Academic Details</th>
                </tr>
                <tr>
                    <td align="right"><strong>🆔 Student ID:</strong></td>
                    <td align="left">
                        <input type="text" name="studentId" value="<%= user.studentId || '' %>" size="30" placeholder="e.g. 01234567">
                    </td>
                </tr>
                <tr>
                    <td align="right"><strong>🏛️ Faculty:</strong></td>
                    <td align="left">
                        <input type="text" name="faculty" value="<%= user.faculty || '' %>" size="30" placeholder="e.g. SCIS">
                    </td>
                </tr>
                <tr>
                    <td align="right" valign="top"><strong>📝 About Me:</strong></td>
                    <td align="left">
                        <textarea name="bio" rows="4" cols="32" placeholder="Tell us about your interests and hobbies..."><%= user.bio || '' %></textarea>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center">
                        <br>
                        <button type="submit">
                            <strong>💾 Save Profile Changes</strong>
                        </button>
                    </td>
                </tr>
            </table>
        </form>
            
        <br>
        <hr width="30%">
        <p>
            <small>Your role is currently set to: <strong><%= user.role.toUpperCase() %></strong></small>
        </p>
    </center>
</body>
</html>
