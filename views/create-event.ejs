<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create an Event!</title>
</head>
<body>
    <h1>Create an Event</h1>
    <p><a href="/events">← Back to Events</a></p>

    <% if (typeof(error) !== 'undefined' && error) { %>
        <p style="color: red; font-weight: bold;"><%= error %></p>
    <% } %>

        <form action="/events/create-event" method="post">
            Title:<br>
            <input type="text" name="title" value="<%= title ? title : "" %>">
            <br><br>
            Description: <br>
            <input type="text" name="description" value="<%= description ? description : "" %>">
            <br><br>
            Date and Time:<br>
            <input type="datetime-local" name="date" value="<%= locals.date ? date : '' %>" required>
            <br><br>
            Location:<br>
            <input type="text" name="location" value="<%= location ? location : "" %>">
            <br><br>
            Maximum Capacity of Attendees: (If left blank, it will be unlimited)<br>
            <input type="number" name="maxAttendees" value="<%= maxAttendees ? maxAttendees : "" %>">
            <br><br>
            Category:<br>
            <label><input type="checkbox" name="category" value="General"> General</label><br>
            <label><input type="checkbox" name="category" value="Sports"> Sports</label><br>
            <label><input type="checkbox" name="category" value="Festivals"> Festivals</label><br>
            <label><input type="checkbox" name="category" value="Hackathons"> Hackathons</label><br>
            <label><input type="checkbox" name="category" value="Discussions"> Panel Discussions</label><br>
            <label><input type="checkbox" name="category" value="Networking"> Networking</label><br>
            <label><input type="checkbox" name="category" value="Others"> Others</label><br>            
            <br><br>
            <button type="submit">Confirm</button>
        </form>
</body>
</html>