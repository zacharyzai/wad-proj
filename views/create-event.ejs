<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create an Event!</title>
</head>
<body>
    <h1>Create an Event</h1>
        <form action="/events/create-event" method="post">
            Title:<br>
            <input type="text" name="title" value="<%= title ? title : "" %>">
            <br><br>
            Description: <br>
            <input type="text" name="description" value="<%= description ? description : "" %>">
            <br><br>
            Date and Time:<br>
            <input type="datetime-local" name="date" value="<%= locals.date ? date : '' %>" required>
            <br><br>
            Location:<br>
            <input type="text" name="location" value="<%= location ? location : "" %>">
            <br><br>
            Category:<br>
            <input type="text" name="category" value="<%= category ? category : "" %>">
            <br><br>
            <button type="submit">Confirm</button>
        </form>
</body>
</html>