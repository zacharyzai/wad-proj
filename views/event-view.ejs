<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event List</title>
</head>

<body align="center">
    <center>
        <br>
        <h1>📅 Campus Event Directory 🎓</h1>
        <p>Discover hackathons, concerts, and club meetings happening around SMU.</p>

        <nav>
            <p>
                <a href="/">🏠 Home</a> |
                <% if (role==='admin' ) { %>
                    <a href="/admin/dashboard">🛠️ Admin Dashboard</a> |
                    <% } %>
                        <a href="/profile">👤 My Profile</a> |
                        <a href="/auth/logout">🚪 Logout</a>
            </p>
        </nav>

        <hr width="90%">
        <% if (typeof(success) !=='undefined' && success) { %>
            <p style="color: green; font-weight: bold;">Action completed successfully!</p>
            <% } %>
                <!--Added success message when update/delete/create is successful-->

                <h1>Event List</h1>
                <!-- Filter Bar -->
                <form method="GET" action="/events">
                    <label for="category">Category:</label>
                    <select name="category" id="category">
                        <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>All</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>>
                                <%= cat %>
                            </option>
                        <% }) %>
                    </select>

                    <label for="sort">Sort by:</label>
                    <select name="sort" id="sort">
                        <option value="" <%= selectedSort === '' ? 'selected' : '' %>>Default</option>
                        <option value="popular" <%= selectedSort === 'popular' ? 'selected' : '' %>>Most Popular</option>
                        <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>Newest</option>
                        <option value="oldest" <%= selectedSort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                    </select>

                    <button type="submit">Apply</button>
                    <a href="/events">Reset</a>
                </form>
                <br>
                <% if (role==='admin' || role==='organizer' ) { %>
                    <table border="0" cellpadding="10">
                        <tr>
                            <td>
                                <strong>Organizer Tools:</strong>
                                <a href="/events/create-event"><button type="button">➕ Create New Event</button></a>
                                <% if (role==='admin' ) { %>
                                    <a href="/events/delete-event"><button type="button">🗑️ Bulk Delete
                                            (Admin)</button></a>
                                    <% } %>
                            </td>
                        </tr>
                    </table>
                    <br>
                    <% } %>
                    <% if (events.length > 0) { %>
                        <table border="1">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Date & Time</th>
                                    <th>Category</th>
                                    <th>Location</th>
                                    <th>Attendees</th>
                                    <th>View Extra Information</th>
                                    <th>Action</th>
                                    <% if (role==='admin' ) { %>
                                        <th>Update Event Details</th>
                                        <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% events.forEach(event=> { %>
                                    <tr>
                                        <td>
                                            <%= event.title %>
                                        </td>
                                        <!-- <td><%= event.date %></td> -->
                                        <td>
                                            <%= event.date.toLocaleString('en-SG', { dateStyle: 'medium' ,
                                                timeStyle: 'short' }) %>
                                        </td>
                                        <!-- toLocaleString is used to format numbers, date to make it readable. 'en-SG' -> specific to SG time. 
                                        dateStyle -> make the appearance of the date clean. timeStyle -> trim GMT -->
                                        <td>
                                            <%= event.category.length > 0 ? event.category.join(', ') : "N/A" %>
                                        </td>
                                        <td>
                                            <%= event.location %>
                                        </td>

                                        <td>
                                            <%= event.attendees.length %> / <%= event.maxAttendees ? event.maxAttendees : "Unlimited" %>
                                        </td>
                                        <td>
                                            <a href="/events/<%= event._id %>">View</a>
                                        </td>
                                        <td>
                                            <% if (event.attendees.includes(userId)) { %>
                                                Already RSVP'd
                                            <% } else if (event.attendees.length >= event.maxAttendees && event.maxAttendees) { %>
                                                Event Full
                                                <% } else { %>
                                                    <form action="/events/<%= event._id %>/rsvp" method="post">
                                                        <button type="submit">RSVP</button>
                                                    </form>
                                                <% } %>
                                        </td>
                                        <% if (role==='admin' || role==="organiser" ) { %>
                                            <td>
                                                <a href="/events/update-event?eventId=<%= event._id %>"><button>Update
                                                        Event</button></a>
                                            </td>
                                            <% } %>
                                    </tr>
                                    <%}) %>

                            </tbody>
                        </table>

                        <p>
                            <% if (page> 1) { %>
                                <button type="submit"><a href="/events?page=<%= page-1 %>">Previous</a></button>
                                <% } %>

                                    <% if (page>= 1 && page < totalPages) { %>
                                            <button type="submit"><a href="/events?page=<%= page+1 %>">Next</a></button>
                                            <% } %>


                                                Page <%= page %> of <%= totalPages %>
                        </p>
                        <% } else { %>
                            <p>No events available at the moment.</p>
                        <% } %>

                        <!-- My Events Portion-->
                        <br>
                        <hr>
                        <h2>My Events</h2>
                        <% if (myEvents.length> 0) { %>
                            <table border="1">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Date & Time</th>
                                        <th>Category</th>
                                        <th>Location</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% myEvents.forEach(event=> { %>
                                        <tr>
                                            <td>
                                                <%= event.title %>
                                            </td>
                                            <td>
                                                <%= event.date.toLocaleString('en-SG', { dateStyle: 'medium' ,
                                                    timeStyle: 'short' }) %>
                                            </td>
                                            <td>
                                                <%= event.category.length > 0 ? event.category.join(', ') : "N/A" %> 
                                                <!-- Able to handle multiple categories now-->
                                            </td>
                                            <td>
                                                <%= event.location %>
                                            </td>
                                            <td>
                                                <form action="/events/<%= event._id%>/unrsvp" method="POST">
                                                    <button type="submit">Un-RSVP</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                            <% } else { %>
                                <p>You haven't RSVP'd to any events yet.</p>
                                <% } %>
    </center>
</body>

</html>