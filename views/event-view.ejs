<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event List</title>
    <title>Event List</title>
</head>
<body>

    <% if (typeof(success) !== 'undefined' && success) { %>
        <p style="color: green; font-weight: bold;">Action completed successfully!</p>
    <% } %> 
    <!--Added success message when update/delete/create is successful-->

    <h1>Event List</h1>
    
    <table border="1">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date & Time</th>
                <th>Category</th>
                <th>Location</th>
                <th>Action</th>
                <th>Attendees</th>
            </tr>
            </thead>
        <tbody>   
            <% events.forEach(event => { %>
                <tr>
                    <td><%= event.title  %></td>
                    <!-- <td><%= event.date %></td> -->
                    <td><%= event.date.toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %></td> <!-- toLocaleString is used to format numbers, date to make it readable. 'en-SG' -> specific to SG time. 
                                                                                                                        dateStyle -> make the appearance of the date clean. timeStyle -> trim GMT -->
                    <td><%= event.category || "N/A"  %></td>
                    <td><%= event.location  %></td>
                    <td>
                        <form action="/events/<%= event._id %>/rsvp" method="post">
                            <button type="submit">RSVP</button>
                        </form>
                    </td>
                    <td><%= event.attendees ? event.attendees.length : 0 %></td>
                </tr>
            <%}) %>
            
        </tbody> 
    </table>

</body>
</html>