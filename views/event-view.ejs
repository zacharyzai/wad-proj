<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event List</title>
</head>
<body>
    <h1>Event List</h1>
    
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Category</th>
                <th>Location</th>
                <th>Action</th>
            </tr>
            </thead>
        <tbody>   
            <% events.forEach(event => { %>
                <tr>
                    <td><%= event.title  %></td>
                    <td><%= event.date  %></td>
                    <td><%= event.category || "N/A"  %></td>
                    <td><%= event.location  %></td>
                    <td>
                        <form action="/events/ <%= event._id %>/rsvp" method="post">
                            <button type="submit">RSVP</button>
                        </form>
                    </td>
                </tr>
            <%}) %>
            
        </tbody> 
    </table>

</body>
</html>