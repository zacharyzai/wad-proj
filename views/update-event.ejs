<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Event</title>
</head>
<body>

    <% if (typeof(error) !== 'undefined' && error) { %>
        <p style="color: red; font-weight: bold;"><%= error %></p>
    <% } %>

    
    <h1>Update Event</h1>
    <p><a href="/events">← Back to Events</a></p>

        <form action="/events/update-event?eventId=<%= targetId ? targetId : '' %>" method="post"> <!-- After the ?, it represents a query string!-->
            <input type="hidden" name="eventId" value="<%= targetId %>">

            Title:<br>
            <input type="text" name="title" value="<%= title ? title : "" %>" style="width:640px; font-size:18px; padding:8px;">
            <br>

            Description: <br>
            <input type="text" name="description" value="<%= description ? description : "" %>">
            <br>

            Date and Time:<br>
            <input type="datetime-local" name="date" value="<%= locals.date ? date : '' %>" required>
            <br>

            Location:<br>
            <input type="text" name="location" value="<%= location ? location : "" %>">
            <br>

            Maximum Capacity of Attendees: <br>
            <input type="number" name="maxAttendees" min="50" value="<%= maxAttendees ? maxAttendees : 50 %>">
            <br><br>

            Category:<br>
            <label><input type="checkbox" name="category" value="General" <%= category && category.includes('General') ? 'checked' : '' %>> General</label><br>
            <label><input type="checkbox" name="category" value="Sports" <%= category && category.includes('Sports') ? 'checked' : '' %>> Sports</label><br>
            <label><input type="checkbox" name="category" value="Festivals" <%= category && category.includes('Festivals') ? 'checked' : '' %>>Festivals</label><br>
            <label><input type="checkbox" name="category" value="Hackathons" <%= category && category.includes('Hackathons') ? 'checked' : '' %>> Hackathons</label><br>
            <label><input type="checkbox" name="category" value="Discussions" <%= category && category.includes('Discussions') ? 'checked' : '' %>>Discussions</label><br>
            <label><input type="checkbox" name="category" value="Networking" <%= category && category.includes('Networking') ? 'checked' : '' %>> Networking</label><br>
            <label><input type="checkbox" name="category" value="Others" <%= category && category.includes('Others') ? 'checked' : '' %>> Others</label><br>
            

            <br><br>
            <button type="submit">Confirm the update</button>
        </form>
    
</body>
</html>