<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Event</title>
</head>
<body>
    <center>
        <form action="/events/update" method="post">
            Title:<br>
            <input type="text" name="title" value="<%= title ? title : "" %>">
            <br>
            Description: <br>
            <input type="text" name="description" value="<%= description ? description : "" %>">
            <br>
            Date:<br>
            <input type="text" name="date" value="<%= date ? date : "" %>">
            <br>
            Location:<br>
            <input type="text" name="location" value="<%= location ? location : "" %>">
            <br>
            Category:<br>
            <input type="text" name="category" value="<%= category ? category : "" %>">
            <br>
            <button type="submit">Confirm the update</button>
        </form>
    </center>
    
</body>
</html>