<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>
</head>
<body align="center">
    <center>
        <br>
        <h1>🛠️ Admin: Edit User Account</h1>
        <p>Modify details for user: <strong><%= user.name %></strong></p>
        <%- include('../partials/navbar') %>

        <hr width="60%">

        <% if (errors && errors.length > 0) { %>
            <table border="1" cellpadding="10" bgcolor="#ffe6e6" width="45%">
                <tr>
                    <td>
                        <strong>⚠️ Update Failed:</strong>
                        <ul>
                            <% errors.forEach(error => { %>
                                <li><%= error %></li>
                            <% }); %>
                        </ul>
                    </td>
                </tr>
            </table>
            <br>
        <% } %>

        <form action="/admin/edit-user/<%= user._id %>" method="post">
            <table border="1" cellpadding="10" width="50%">
                <tr bgcolor="#eeeeee">
                    <th colspan="2">Account Information</th>
                </tr>
                <tr>
                    <td align="right"><strong>👤 Full Name:</strong></td>
                    <td align="left">
                        <input type="text" name="name" value="<%= user.name %>" required size="30">
                    </td>
                </tr>
                <tr>
                    <td align="right"><strong>📧 Email:</strong></td>
                    <td align="left">
                        <input type="email" name="email" value="<%= user.email %>" required size="30">
                    </td>
                </tr>
                <tr>
                    <td align="right"><strong>🎭 Role:</strong></td>
                    <td align="left">
                        <select name="role" style="width: 100%;">
                            <option value="student" <%= user.role === 'student' ? 'selected' : '' %>>Student</option>
                            <option value="organizer" <%= user.role === 'organizer' ? 'selected' : '' %>>Organizer</option>
                            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                        </select>
                    </td>
                </tr>
                <tr bgcolor="#f9f9f9">
                    <th colspan="2">Profile Details (Optional)</th>
                </tr>
                <tr>
                    <td align="right"><strong>🆔 Student ID:</strong></td>
                    <td align="left">
                        <input type="text" name="studentId" value="<%= user.studentId || '' %>" size="30">
                    </td>
                </tr>
                <tr>
                    <td align="right"><strong>🏛️ Faculty:</strong></td>
                    <td align="left">
                        <input type="text" name="faculty" value="<%= user.faculty || '' %>" size="30">
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center">
                        <br>
                        <button type="submit">
                            <strong>💾 Save User Changes</strong>
                        </button>
                    </td>
                </tr>
            </table>
        </form>

        <br>
        <hr width="30%">
        <p>
            <a href="/">🏠 Back to Home</a>
        </p>
    </center>
</body>
</html>