<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>

<body align="center">
    <center>
        <br>
        <h1>🛠️ Admin Control Panel</h1>
        <p>Logged in as: <strong><%= userName %></strong> (Administrator)</p>

        <nav>
            <p>
                <a href="/">🏠 Home</a> |
                <a href="/events">🔍 Browse Events</a> |
                <a href="/profile">👤 Profile</a> |
                <a href="/auth/logout">🚪 Logout</a>
            </p>
        </nav>

        <hr width="80%">

        <!-- Summary Stats -->
        <table border="0" cellpadding="10">
            <tr>
                <td align="center" bgcolor="#e8f4fd">
                    <strong>Total Users:</strong><br>
                    <font size="4"><%= users.length %></font>
                </td>
                <td width="20"></td>
                <td align="center" bgcolor="#e8fdf0">
                    <strong>Total Events:</strong><br>
                    <font size="4"><%= events.length %></font>
                </td>
                <td width="20"></td>
                <td align="center" bgcolor="#fdfae8">
                    <strong>Total RSVPs:</strong><br>
                    <font size="4"><%= totalRSVPs %></font>
                </td>
                <td width="20"></td>
                <td align="center" bgcolor="#f0e8fd">
                    <strong>Avg RSVPs / Event:</strong><br>
                    <font size="4"><%= events.length > 0 ? (totalRSVPs / events.length).toFixed(1) : 0 %></font>
                </td>
                <td width="20"></td>
                <td align="center" bgcolor="#fde8f4">
                    <strong>Quick Actions:</strong><br>
                    <a href="/admin/create-user">➕ New User</a> &nbsp;|&nbsp;
                    <a href="/events/create-event">📅 New Event</a> &nbsp;|&nbsp;
                    <a href="/events">📋 Manage Events</a>
                </td>
            </tr>
        </table>

        <br>
        <hr width="80%">

        <!-- Charts Section -->
        <h3>📊 Analytics</h3>

        <!-- Row 1: Role Distribution + Events by Category -->
        <table border="0" cellpadding="20">
            <tr>
                <td align="center" bgcolor="#f9f9f9" width="380">
                    <strong>👥 User Role Distribution</strong><br><br>
                    <canvas id="userRoleChart" width="340" height="240"></canvas>
                </td>
                <td width="20"></td>
                <td align="center" bgcolor="#f9f9f9" width="380">
                    <strong>📂 Events by Category</strong><br><br>
                    <canvas id="categoryChart" width="340" height="240"></canvas>
                </td>
            </tr>
        </table>

        <br>

        <!-- Row 2: Top Events + Event Status -->
        <table border="0" cellpadding="20">
            <tr>
                <td align="center" bgcolor="#f9f9f9" width="380">
                    <strong>🏆 Top 5 Events by Attendance</strong><br><br>
                    <canvas id="topEventsChart" width="340" height="240"></canvas>
                </td>
                <td width="20"></td>
                <td align="center" bgcolor="#f9f9f9" width="380">
                    <strong>🗓️ Event Status Breakdown</strong><br><br>
                    <canvas id="statusChart" width="340" height="240"></canvas>
                </td>
            </tr>
        </table>

        <br>

        <!-- Row 3: Monthly Trend -->
        <table border="0" cellpadding="20" width="80%">
            <tr>
                <td align="center" bgcolor="#f9f9f9">
                    <strong>📅 Events Created — Last 6 Months</strong><br><br>
                    <canvas id="monthlyChart" height="100"></canvas>
                </td>
            </tr>
        </table>

        <br>
        <hr width="80%">

        <!-- User Directory -->
        <section>
            <h3>👤 User Directory</h3>
            <% if (users.length === 0) { %>
                <p>No users found in the database.</p>
            <% } else { %>
                <table border="1" cellpadding="10" width="90%">
                    <thead>
                        <tr bgcolor="#eeeeee">
                            <th>Full Name</th>
                            <th>Email Address</th>
                            <th>System Role</th>
                            <th>Student ID</th>
                            <th>Faculty</th>
                            <th>Management Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td><%= user.name %></td>
                                <td><%= user.email %></td>
                                <td>
                                    <% if (user.role === 'admin') { %>
                                        <strong>⭐ ADMIN</strong>
                                    <% } else if (user.role === 'organizer') { %>
                                        💼 Organizer
                                    <% } else { %>
                                        👨‍🎓 Student
                                    <% } %>
                                </td>
                                <td><%= user.studentId || '-' %></td>
                                <td><%= user.faculty || '-' %></td>
                                <td align="center">
                                    <a href="/admin/edit-user/<%= user._id %>">📝 Edit</a>
                                    &nbsp;|&nbsp;
                                    <% if (user._id.toString() !== currentUserId) { %>
                                        <form action="/admin/delete-user/<%= user._id %>"
                                              method="post"
                                              style="display:inline;">
                                            <button type="submit"
                                                    onclick="return confirm('⚠️ Are you sure you want to delete this user? This cannot be undone.')">
                                                🗑️ Delete
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <em>(You)</em>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </section>

    </center>

    <!-- Inject server data for charts -->
    <script id="dashboardData" type="application/json">
        <%- JSON.stringify({ usersByRole, eventsByCategory, topEvents, upcomingCount, pastCount, monthLabels, monthCounts }) %>
    </script>

    <script>
        const _d = JSON.parse(document.getElementById('dashboardData').textContent);
        const { usersByRole, eventsByCategory, topEvents, upcomingCount, pastCount, monthLabels, monthCounts } = _d;

        // 1. User Role Distribution — Doughnut
        new Chart(document.getElementById('userRoleChart'), {
            type: 'doughnut',
            data: {
                labels: ['Students', 'Organizers', 'Admins'],
                datasets: [{
                    data: [usersByRole.student || 0, usersByRole.organizer || 0, usersByRole.admin || 0],
                    backgroundColor: ['#5cb85c', '#5bc0de', '#d9534f'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // 2. Events by Category — Bar
        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: Object.keys(eventsByCategory),
                datasets: [{
                    label: 'Events',
                    data: Object.values(eventsByCategory),
                    backgroundColor: ['#5bc0de','#d9534f','#5cb85c','#f0ad4e','#9b59b6','#1abc9c','#95a5a6'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 3. Top 5 Events by Attendance — Horizontal Bar
        new Chart(document.getElementById('topEventsChart'), {
            type: 'bar',
            data: {
                labels: topEvents.map(e => e.title.length > 20 ? e.title.slice(0, 20) + '…' : e.title),
                datasets: [{
                    label: 'Attendees',
                    data: topEvents.map(e => e.count),
                    backgroundColor: '#5bc0de',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: false,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 4. Event Status — Pie
        new Chart(document.getElementById('statusChart'), {
            type: 'pie',
            data: {
                labels: ['Upcoming', 'Past'],
                datasets: [{
                    data: [upcomingCount, pastCount],
                    backgroundColor: ['#5cb85c', '#aaaaaa'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // 5. Events Created Per Month — Line
        new Chart(document.getElementById('monthlyChart'), {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Events Created',
                    data: monthCounts,
                    borderColor: '#5bc0de',
                    backgroundColor: 'rgba(91,192,222,0.15)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
</body>
</html>
