<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration</title>
</head>
<body align="center">
    <center>
        <br>
        <h1>📝 Create an Account</h1>
        <p>Join the <strong>Campus Event Board</strong> to start discovering and managing events.</p>
        
        <hr width="50%">

        <% if (errors && errors.length > 0) { %>
            <table border="1" cellpadding="10" bgcolor="#ffe6e6" width="45%">
                <tr>
                    <td>
                        <strong>⚠️ Registration Issues:</strong>
                        <ul>
                            <% errors.forEach(error => { %>
                                <li><%= error %></li>
                            <% }); %>
                        </ul>
                    </td>
                </tr>
            </table>
            <br>
        <% } %>

        <form action="/auth/register" method="post">
            <table border="0" cellpadding="8">
                <tr>
                    <td align="right"><strong>👤 Full Name:</strong></td>
                    <td><input type="text" name="name" required size="30" placeholder="e.g. John Doe"></td>
                </tr>
                <tr>
                    <td align="right"><strong>📧 Email:</strong></td>
                    <td><input type="email" name="email" required size="30" placeholder="student@smu.edu.sg"></td>
                </tr>
                <tr>
                    <td align="right"><strong>🔒 Password:</strong></td>
                    <td><input type="password" name="password" required size="30"></td>
                </tr>
                <tr>
                    <td align="right"><strong>🎭 Role:</strong></td>
                    <td align="left">
                        <select name="role" style="width: 100%;">
                            <option value="student">Student</option>
                            <option value="organizer">Organizer</option>
                            <option value="admin">Admin</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td align="right" valign="top"><strong>📝 Brief Bio:</strong></td>
                    <td>
                        <textarea name="bio" rows="3" cols="32" placeholder="Tell us about your interests..."></textarea>
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td align="left">
                        <br>
                        <button type="submit">
                            <strong>Register Account</strong>
                        </button>
                    </td>
                </tr>
            </table>
        </form>

        <br>
        <hr width="30%">
        
        <p>
            <a href="/auth/login">Already have an account? Login here</a><br><br>
            <a href="/">🏠 Back to Home</a>
        </p>
    </center>
</body>
</html>